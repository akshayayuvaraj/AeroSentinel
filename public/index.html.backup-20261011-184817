async function sendReport() {
  const b = $('#rbtn');
  const m = $('#rmsg');

  const latValue = $('#rlat').value.trim();
  const lngValue = $('#rlng').value.trim();
  const description = $('#rdesc').value.trim();

  // Validate coordinates.
  const lat = Number(latValue);
  const lng = Number(lngValue);

  if (
    !latValue ||
    !lngValue ||
    !Number.isFinite(lat) ||
    !Number.isFinite(lng) ||
    Math.abs(lat) > 90 ||
    Math.abs(lng) > 180
  ) {
    m.innerHTML =
      '<p class="err" role="alert">' +
      'Enter a valid latitude and longitude.' +
      '</p>';
    return;
  }

  // Validate the report description.
  if (!description || description.length > 500) {
    m.innerHTML =
      '<p class="err" role="alert">' +
      'Describe what you saw (1–500 characters).' +
      '</p>';
    return;
  }

  const fileInput = $('#rphoto');
  const file = fileInput.files[0];

  // Compress the image and return a complete JPEG data URL.
  async function compressPhoto(file) {
    if (!file.type.startsWith('image/')) {
      throw new Error('Please select a valid image file.');
    }

    let bitmap;

    try {
      bitmap = await createImageBitmap(file);
    } catch {
      throw new Error(
        'Could not read this image. Please choose another photo.'
      );
    }

    try {
      const originalWidth = bitmap.width;
      const originalHeight = bitmap.height;

      if (!originalWidth || !originalHeight) {
        throw new Error('The selected image has invalid dimensions.');
      }

      const attempts = [
        { maxDimension: 1280, quality: 0.76 },
        { maxDimension: 1024, quality: 0.70 },
        { maxDimension: 800, quality: 0.65 },
        { maxDimension: 640, quality: 0.60 }
      ];

      for (const attempt of attempts) {
        const scale = Math.min(
          1,
          attempt.maxDimension /
            Math.max(originalWidth, originalHeight)
        );

        const width = Math.max(
          1,
          Math.round(originalWidth * scale)
        );

        const height = Math.max(
          1,
          Math.round(originalHeight * scale)
        );

        const canvas = document.createElement('canvas');
        canvas.width = width;
        canvas.height = height;

        const context = canvas.getContext('2d');

        if (!context) {
          throw new Error('Could not prepare the photo.');
        }

        // Fill white behind transparent images before JPEG conversion.
        context.fillStyle = '#ffffff';
        context.fillRect(0, 0, width, height);
        context.drawImage(bitmap, 0, 0, width, height);

        const blob = await new Promise((resolve, reject) => {
          canvas.toBlob(
            result => {
              if (result) {
                resolve(result);
              } else {
                reject(new Error('Could not compress the photo.'));
              }
            },
            'image/jpeg',
            attempt.quality
          );
        });

        // Leave room for the remaining JSON request data.
        const maxBase64Length = 4.5 * 1024 * 1024;

        if (blob.size * 4 / 3 <= maxBase64Length) {
          const dataUrl = await new Promise((resolve, reject) => {
            const reader = new FileReader();

            reader.onload = () => resolve(reader.result);
            reader.onerror = () => {
              reject(
                new Error('Could not read the compressed photo.')
              );
            };

            reader.readAsDataURL(blob);
          });

          // IMPORTANT: preserve the data:image/jpeg;base64, prefix.
          return {
            data: String(dataUrl),
            name: file.name.replace(/\.[^.]+$/, '') + '.jpg',
            size: blob.size
          };
        }

        canvas.width = 0;
        canvas.height = 0;
      }

      throw new Error(
        'This photo is still too large after compression. ' +
        'Please choose a smaller image.'
      );
    } finally {
      bitmap.close();
    }
  }

  b.disabled = true;
  b.textContent = 'Preparing photo…';
  m.innerHTML = '';

  try {
    let photo = null;
    let photoName = null;

    // A photo is optional.
    if (file) {
      const compressed = await compressPhoto(file);

      photo = compressed.data;
      photoName = compressed.name;

      m.innerHTML =
        '<p class="mu">Photo compressed to ' +
        (compressed.size / 1024).toFixed(0) +
        ' KB. Submitting report…</p>';
    }

    b.textContent = 'Submitting…';

    const result = await api('/reports', 'POST', {
      lat: latValue,
      lng: lngValue,
      description,
      timestamp: new Date().toISOString(),
      photo,
      photoName
    });

    m.innerHTML = `
      <div class="sec">
        <h3 class="k">Confirmation</h3>
        <p class="ok"><b>${esc(result.message)}</b></p>

        <div class="kv">
          <span>Linked incident</span>
          <span>
            <a href="#/incident/${encodeURIComponent(result.incidentId)}">
              ${esc(result.incidentId)}
            </a>
          </span>
        </div>

        <div class="kv">
          <span>Status</span>
          <span>${tag(result.status)}</span>
        </div>

        <div class="kv">
          <span>Photo</span>
          <span>
            ${result.photo ? esc(result.photo.storage) : 'None'}
          </span>
        </div>
      </div>
    `;

    toast('Report received successfully.');
  } catch (error) {
    m.innerHTML =
      '<p class="err" role="alert">' +
      esc(error.message || 'Could not submit the report.') +
      '</p>';

    toast(error.message || 'Report submission failed.', 'bad');
  } finally {
    b.disabled = false;
    b.textContent = 'Submit report';
  }
}
