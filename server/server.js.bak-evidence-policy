function mk(id, status, lat, lng, aqi, evidence) {
  return {
    incidentId: id,
    status,
    incidentType: 'SUSPECTED_STUBBLE_BURNING',
    location: {
      type: 'Point',
      coordinates: [lng, lat]
    },
    groundAQI: aqi,
    evidence,
    evidenceScore: evidence.reduce((sum, item) => sum + item.pts, 0),
    exposure: null,
    recommendation: null,
    policy: null,
    advisory: null,
    decisions: [],
    detectedAt: new Date().toISOString()
  };
}

