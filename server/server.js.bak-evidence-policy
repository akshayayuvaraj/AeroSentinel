if (require.main === module) {
  if (process.argv.includes('--selftest')) {
    const server = app.listen(0, async () => {
      try {
        const base =
          `http://localhost:${server.address().port}/api/incidents/INC-001`;

        const request = (url, method, body = {}) =>
          fetch(base + url, {
            method,
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(body)
          }).then(async response => {
            const data = await response.json();

            if (!response.ok) {
              throw new Error(data.error || `HTTP ${response.status}`);
            }

            return data;
          });

        await request('/verify', 'PATCH', { action: 'VERIFY' });
        await request('/exposure', 'POST');
        await request('/advisory', 'POST');

        const incident = await request('/policy-check', 'POST');

        console.log('Self-test result:', {
          exposure: incident.exposure?.level,
          policy: incident.policy?.decision,
          advisory: incident.advisory?.status
        });
      } catch (error) {
        console.error('Self-test failed:', error.message);
        process.exitCode = 1;
      } finally {
        server.close();
      }
    });
  } else {
    const port = process.env.PORT || 3000;

    app.listen(port, () => {
      console.log(`AeroSentinel on http://localhost:${port}`);
    });
  }
}
